{
  "root": "CardDeck",
  "components": {
    "CardDeck": {
      "signature": "CardDeck(children: GeneratedCard[], layout?: \"auto\" | \"deck\" | \"grid\" | \"featured\")",
      "description": "The only OpenUI root. Lays out GeneratedCard peers as a horizontal snap deck in narrow containers and a responsive grid in wide containers."
    },
    "GeneratedCard": {
      "signature": "GeneratedCard(cardId: string, title: string, children: any[], variant?: \"standard\" | \"hero\" | \"editorial\" | \"comparison\" | \"timeline\" | \"data\" | \"action\" | \"media\", density?: \"compact\" | \"balanced\" | \"immersive\", subtitle?: string)",
      "description": "One peer card in a CardDeck. The host supplies cardId and title; compose its children freely without adding another card boundary."
    },
    "FixedCardContent": {
      "signature": "FixedCardContent(content: (FixedFacts | FixedList | FixedMetrics | FixedTimeline | FixedComparison | FixedMedia | FixedGallery | FixedFacts | FixedList | FixedMetrics)[], actions?: FixedActions)",
      "description": "Required body grammar for a 600x300 GeneratedCard: one primary region, optional compact secondary region, and optional FixedActions row."
    },
    "FixedFacts": {
      "signature": "FixedFacts(items: string[])",
      "description": "Bounded fixed-canvas fact list. Use 1-4 concise facts; every fact remains visible."
    },
    "FixedList": {
      "signature": "FixedList(items: {title: string, detail?: string}[])",
      "description": "Bounded fixed-canvas list with at most four visible rows."
    },
    "FixedMetrics": {
      "signature": "FixedMetrics(items: {label: string, value: string, detail?: string}[])",
      "description": "One fixed-height row containing one to three metrics."
    },
    "FixedTimeline": {
      "signature": "FixedTimeline(items: {title: string, detail?: string, meta?: string}[])",
      "description": "Bounded timeline with at most four compact milestones."
    },
    "FixedComparison": {
      "signature": "FixedComparison(columns: {title: string, badge?: string, rows: {label: string, value: string}[]}[])",
      "description": "Two compact comparison columns with at most three rows each."
    },
    "FixedMedia": {
      "signature": "FixedMedia(title: string, subtitle?: string, assetRef?: string, badges?: string[])",
      "description": "Fixed-height host-owned media hero. assetRef is an optional host-provided ID, never a URL."
    },
    "FixedGallery": {
      "signature": "FixedGallery(assetRefs: string[])",
      "description": "Fixed-height two-image gallery using only host-owned assetRef IDs."
    },
    "FixedActions": {
      "signature": "FixedActions(actions: (HostActionChip | HostActionItem)[])",
      "description": "One fixed-height action row with one or two host-bound actions."
    },
    "HostActionChip": {
      "signature": "HostActionChip(label: string, actionRef: string)",
      "description": "Compact host-side action affordance. actionRef must be copied exactly from designBrief.actions."
    },
    "HostActionItem": {
      "signature": "HostActionItem(label: string, actionRef: string, description?: string)",
      "description": "A host-side action rendered as a descriptive list or menu row."
    }
  },
  "componentGroups": [
    {
      "name": "Prompt Capability Palette",
      "components": [
        "CardDeck",
        "GeneratedCard",
        "FixedCardContent",
        "FixedFacts",
        "FixedList",
        "FixedMetrics",
        "FixedTimeline",
        "FixedComparison",
        "FixedMedia",
        "FixedGallery",
        "FixedActions",
        "HostActionChip",
        "HostActionItem"
      ],
      "notes": [
        "CardDeck is the only root.",
        "GeneratedCard is the only peer-card boundary.",
        "Raw URLs and external tool calls are forbidden."
      ]
    }
  ],
