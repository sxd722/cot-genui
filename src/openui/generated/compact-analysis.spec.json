        "PieChart",
        "Series",
        "Slice",
        "ComparisonGrid",
        "ActionPanel",
        "HostActionChip",
        "HostActionItem",
        "Separator",
        "AssetImage",
        "AssetGallery"
      ],
      "notes": [
        "CardDeck is the only root.",
        "GeneratedCard is the only peer-card boundary.",
        "Raw URLs and external tool calls are forbidden."
      ]
    }
  ],
