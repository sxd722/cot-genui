{
  "root": "CardDeck",
  "components": {
    "CardDeck": {
      "signature": "CardDeck(children: GeneratedCard[], layout?: \"auto\" | \"deck\" | \"grid\" | \"featured\")",
      "description": "The only OpenUI root. Lays out GeneratedCard peers as a horizontal snap deck in narrow containers and a responsive grid in wide containers."
    },
    "GeneratedCard": {
      "signature": "GeneratedCard(cardId: string, title: string, children: any[], variant?: \"standard\" | \"hero\" | \"editorial\" | \"comparison\" | \"timeline\" | \"data\" | \"action\" | \"media\", density?: \"compact\" | \"balanced\" | \"immersive\", subtitle?: string)",
      "description": "One peer card in a CardDeck. The host supplies cardId and title; compose its children freely without adding another card boundary."
    },
    "TextContent": {
      "signature": "TextContent(text: string, size?: \"small\" | \"default\" | \"large\" | \"small-heavy\" | \"large-heavy\")",
      "description": "Text block. Supports markdown. Optional size: \"small\" | \"default\" | \"large\" | \"small-heavy\" | \"large-heavy\"."
    },
    "Stack": {
      "signature": "Stack(children: any[], direction?: \"row\" | \"column\", gap?: \"none\" | \"xs\" | \"s\" | \"m\" | \"l\" | \"xl\" | \"2xl\", align?: \"start\" | \"center\" | \"end\" | \"stretch\" | \"baseline\", justify?: \"start\" | \"center\" | \"end\" | \"between\" | \"around\" | \"evenly\", wrap?: boolean)",
      "description": "Flex container. direction: \"row\"|\"column\" (default \"column\"). gap: \"none\"|\"xs\"|\"s\"|\"m\"|\"l\"|\"xl\"|\"2xl\" (default \"m\"). align: \"start\"|\"center\"|\"end\"|\"stretch\"|\"baseline\". justify: \"start\"|\"center\"|\"end\"|\"between\"|\"around\"|\"evenly\"."
    },
    "Callout": {
      "signature": "Callout(variant: \"info\" | \"warning\" | \"error\" | \"success\" | \"neutral\", title: string, description: string, visible?: $binding<boolean>)",
      "description": "Callout banner. Optional visible is a reactive $boolean — auto-dismisses after 3s by setting $visible to false."
    },
    "TagBlock": {
      "signature": "TagBlock(tags: string[])",
      "description": "tags is an array of strings"
    },
    "Table": {
      "signature": "Table(columns: Col[])",
      "description": "Data table — column-oriented. Each Col holds its own data array."
    },
    "Col": {
      "signature": "Col(label: string, data: any, type?: \"string\" | \"number\" | \"action\")",
      "description": "Column definition — holds label + data array"
    },
    "MetricRow": {
      "signature": "MetricRow(items: {label: string, value: string, detail?: string}[])",
      "description": "A compact row of key metrics. Prefer this over manually stacking labels and values."
    },
    "BarChart": {
      "signature": "BarChart(labels: string[], series: Series[], variant?: \"grouped\" | \"stacked\", xLabel?: string, yLabel?: string)",
      "description": "Vertical bars; use for comparing values across categories with one or more series"
    },
    "LineChart": {
      "signature": "LineChart(labels: string[], series: Series[], variant?: \"linear\" | \"natural\" | \"step\", xLabel?: string, yLabel?: string)",
      "description": "Lines over categories; use for trends and continuous data over time"
    },
    "AreaChart": {
      "signature": "AreaChart(labels: string[], series: Series[], variant?: \"linear\" | \"natural\" | \"step\", xLabel?: string, yLabel?: string)",
      "description": "Filled area under lines; use for cumulative totals or volume trends over time"
    },
    "PieChart": {
      "signature": "PieChart(labels: string[], values: number[], variant?: \"pie\" | \"donut\", appearance?: \"circular\" | \"semiCircular\")",
      "description": "Circular slices; use plucked arrays: PieChart(data.categories, data.values)"
    },
    "Series": {
      "signature": "Series(category: string, values: number[])",
      "description": "One data series"
    },
    "Slice": {
      "signature": "Slice(category: string, value: number)",
      "description": "One slice with label and numeric value"
    },
    "ComparisonGrid": {
      "signature": "ComparisonGrid(columns: {title: string, rows: {label: string, value: string}[], badge?: string}[])",
      "description": "Side-by-side option columns with consistently labeled comparison rows."
    },
    "ActionPanel": {
      "signature": "ActionPanel(title?: string, description?: string, actions: (HostActionChip | HostActionItem)[])",
      "description": "A focused host-action region. Its children must be supplied HostActionChip or HostActionItem refs."
    },
    "HostActionChip": {
      "signature": "HostActionChip(label: string, actionRef: string)",
      "description": "Compact host-side action affordance. actionRef must be copied exactly from designBrief.actions."
    },
    "HostActionItem": {
      "signature": "HostActionItem(label: string, actionRef: string, description?: string)",
      "description": "A host-side action rendered as a descriptive list or menu row."
    },
    "Separator": {
      "signature": "Separator(orientation?: \"horizontal\" | \"vertical\", decorative?: boolean)",
      "description": "Visual divider between content sections"
    },
    "AssetImage": {
      "signature": "AssetImage(assetRef: string, alt?: string, aspect?: \"wide\" | \"square\" | \"portrait\")",
      "description": "Displays a host-resolved image by assetRef. assetRef must come from availableAssets; never pass a URL."
    },
    "AssetGallery": {
      "signature": "AssetGallery(assetRefs: string[], columns?: 2 | 3)",
      "description": "Displays host-resolved image IDs as a two- or three-column gallery. Never pass URLs."
    }
  },
  "componentGroups": [
    {
      "name": "Prompt Capability Palette",
      "components": [
        "CardDeck",
        "GeneratedCard",
        "TextContent",
        "Stack",
        "Callout",
