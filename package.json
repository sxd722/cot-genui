{
  "name": "cot-genui",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "generate:openui": "openui generate src/openui/library.tsx --spec --out src/openui/generated/system-prompt.spec.json --export library --no-interactive --agent-name codex",
    "dev": "npm run generate:openui && next dev",
    "build": "npm run generate:openui && next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@openuidev/lang-core": "0.2.11",
    "@openuidev/react-headless": "0.9.8",
    "@openuidev/react-lang": "0.2.11",
    "@openuidev/react-ui": "0.13.6",
    "ai": "6.0.116",
    "lit": "^3.3.3",
    "next": "16.3.0",
    "openai": "^7.4.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "zod": "4.4.3",
    "zustand": "4.5.7"
  },
  "devDependencies": {
    "@openuidev/cli": "^0.2.8",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
