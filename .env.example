# LLM 配置（兼容 OpenAI 接口的任意端点）
# 不填也可运行：前端会使用 mock 输出调试 UI

# API Key（必填才走真实推理）
# 默认 provider：Groq OpenAI-compatible API
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=qwen/qwen3.6-27b

# 无需密钥的临时 Hugging Face Community Endpoint；运营方可能随时下线。
HF_COMMUNITY_BASE_URL=https://g9hnto0u7lvbu837.us-east-2.aws.endpoints.huggingface.cloud/v1
HF_COMMUNITY_TIMEOUT_MS=120000

# NVIDIA Build：DiffusionGemma 文本推理（不会向模型声明工具）
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_TIMEOUT_MS=120000

# 备用 provider：保留 GLM 模型选项
LLM_API_KEY=

# Base URL（可选，指向 GLM / DeepSeek / Azure 等兼容端点）
# 例: https://open.bigmodel.cn/api/paas/v4
LLM_BASE_URL=

# 兼容旧 /api/llm 接口的默认模型
LLM_MODEL=glm-5.2

# 六阶段模型可逐步选择；包含 Groq、临时 HF Community Qwen3.8-27B、NVIDIA DiffusionGemma 和三档 GLM。

# 可选：美元/百万 token 的精确定价。未配置的模型只显示 token，不显示猜测费用。
# 例：{"glm-5.2":{"input":0.8,"output":2.0,"cachedInput":0.2}}
LLM_PRICING_JSON=

# Host-owned OpenUI 图片解析（密钥仅在服务端使用，不会发送给 OpenUI 模型或浏览器代码）
# false 时仍记录 assetRequest，但 providerState 为 disabled；默认 true。
NEXT_PUBLIC_OPENUI_ASSETS=true

# 图片 Provider 链（按序回退）：custom-http-v1 → Pexels → Openverse → Noop。
# 前一个 provider 请求失败或未产出可接受资产时，自动尝试下一个。

# 推荐的免费图片 Provider（视觉质量优先）：https://www.pexels.com/api/ 免费申请。
PEXELS_API_KEY=

# 无需 key 的开放授权兜底 Provider；设为 off 关闭（默认 on）。
OPENVERSE_IMAGES=on

# 可选的自定义图片搜索端点（显式配置时优先级最高）。
# 端点必须实现 README 中的 custom-http-v1 契约，不能直接填写任意第三方图片 API。
IMAGE_SEARCH_API_URL=
IMAGE_SEARCH_API_KEY=
# Provider POST 请求超时；图片 URL 自身另有独立、较短的 HEAD/GET 校验超时。
IMAGE_SEARCH_TIMEOUT_MS=5000

# 图片 URL DNS 安全校验。默认使用系统 DNS；只有 TUN/fake-IP 将公网域名映射到
# 198.18.0.0/15 时才启用 doh-fallback。其他私网/保留地址不会使用 DoH 绕过。
IMAGE_DNS_VALIDATION_MODE=system
# IMAGE_DNS_VALIDATION_MODE=doh-fallback
IMAGE_DNS_DOH_URL=https://cloudflare-dns.com/dns-query

# 本地 Image Gateway（npm run dev:image-gateway）。Gateway 是服务端搜索适配层，
# 返回的候选图片仍会经过 cot-genui 的公网 HTTPS/SSRF/DNS/redirect 校验。
IMAGE_GATEWAY_HOST=127.0.0.1
IMAGE_GATEWAY_PORT=4010
IMAGE_GATEWAY_API_KEY=local-dev
# 可选顺序：pexels,openverse,searxng。无 Pexels key / SearXNG URL 的条目会被跳过。
IMAGE_GATEWAY_PROVIDERS=pexels,openverse,searxng
IMAGE_GATEWAY_PEXELS_API_KEY=
IMAGE_GATEWAY_SEARXNG_URL=
